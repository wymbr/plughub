{
  "skill_id": "skill_probe_voz39_v1",
  "name": "Probe - faixa fixa de gravacao no widget (VOZ-39)",
  "version": "1.0",
  "description": "Fixture do probe_voz39_recording_badge: cumprimenta, espera o cliente digitar qualquer coisa (a chamada fica viva o bastante para a gravacao comecar e o estado chegar ao widget) e encerra. Os marcadores voz39-* dizem ao exercicio onde o fluxo esta.",
  "classification": {"type": "orchestrator"},
  "flow": {
    "entry": "n0",
    "steps": [
      {"id": "n0", "type": "notify", "message": "voz39-inicio", "on_success": "m0", "on_failure": "fim_falha"},
      {"id": "m0", "type": "menu", "interaction": "text", "prompt": "Digite qualquer coisa para terminar.", "timeout_s": 150, "output_as": "r", "on_success": "n1", "on_failure": "fim_falha", "on_timeout": "fim_falha"},
      {"id": "n1", "type": "notify", "message": "voz39-fim", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "fim", "type": "complete", "outcome": "resolved", "issue_status": "probe: voz39 concluido"},
      {"id": "fim_falha", "type": "complete", "outcome": "failed", "issue_status": "probe: voz39 falhou"}
    ]
  }
}

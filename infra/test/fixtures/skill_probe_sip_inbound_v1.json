{
  "skill_id": "skill_probe_sip_inbound_v1",
  "name": "Probe - chamada telefonica entrante pela perna SIP (VOZ-02, VOZ-31)",
  "version": "1.1",
  "description": "Fixture do probe_voz02_sip_inbound: cumprimenta (e e a fala que ATENDE a chamada — o servico SIP so atende quando ha audio na sala), pergunta por voz ou tecla com duas opcoes (m0), pede um codigo pelo TECLADO terminado em # (m1, VOZ-31) e um PIN MASCARADO (m2, NIV-07: coletado por tecla sob pausa de midia — a sala fica so com o cliente e os bots). Cada desfecho vira um marcador; o PIN nunca volta ao cliente. Depois encerra: e o encerramento que derruba a chamada pelo lado da plataforma.",
  "classification": {"type": "orchestrator"},
  "flow": {
    "entry": "n0",
    "steps": [
      {"id": "n0", "type": "notify", "message": "Ola. Voce ligou para o teste da plataforma.", "on_success": "m0", "on_failure": "fim_falha"},
      {"id": "m0", "type": "menu", "interaction": "button", "prompt": "Diga atendente ou cancelar.",
       "options": [{"id": "cancelar", "label": "Cancelar"}, {"id": "atendente", "label": "Atendente"}],
       "timeout_s": 120, "output_as": "r0",
       "collect": {"input": ["voice", "dtmf"], "first_input_timeout_s": 30, "max_invalid": 1},
       "on_success": "v0", "on_failure": "fim_falha", "on_timeout": "n_to", "on_invalid": "i0"},
      {"id": "v0", "type": "notify", "message": "sip-m0={{$.pipeline_state.r0}}", "on_success": "m1", "on_failure": "fim_falha"},
      {"id": "m1", "type": "menu", "interaction": "text", "prompt": "Digite o codigo e termine com jogo da velha.",
       "timeout_s": 90, "output_as": "r1",
       "collect": {"input": ["dtmf"], "first_input_timeout_s": 30, "max_digits": 6, "terminator": "#", "max_invalid": 1},
       "on_success": "v1", "on_failure": "fim_falha", "on_timeout": "n1_to", "on_invalid": "i1"},
      {"id": "v1", "type": "notify", "message": "sip-m1={{$.pipeline_state.r1}}", "on_success": "tx", "on_failure": "fim_falha"},
      {"id": "tx", "type": "begin_transaction", "on_failure": "fim_falha"},
      {"id": "m2", "type": "menu", "interaction": "text", "prompt": "Digite o PIN e termine com jogo da velha.",
       "masked": "credential", "timeout_s": 20, "output_as": "pin",
       "collect": {"input": ["dtmf"], "first_input_timeout_s": 15, "min_digits": 4, "max_digits": 6, "terminator": "#"},
       "on_success": "v2", "on_failure": "fim_falha", "on_timeout": "n2_to"},
      {"id": "v2", "type": "notify", "message": "sip-m2-recebido", "on_success": "tx_fim", "on_failure": "fim_falha"},
      {"id": "tx_fim", "type": "end_transaction", "result_as": "auth", "on_success": "fim"},
      {"id": "n2_to", "type": "notify", "message": "sip-m2-timeout", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "i0", "type": "notify", "message": "sip-m0-invalido", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "n_to", "type": "notify", "message": "sip-timeout", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "i1", "type": "notify", "message": "sip-m1-invalido", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "n1_to", "type": "notify", "message": "sip-m1-timeout", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "fim", "type": "complete", "outcome": "resolved", "issue_status": "probe: chamada telefonica atendida"},
      {"id": "fim_falha", "type": "complete", "outcome": "failed", "issue_status": "probe: fluxo falhou"}
    ]
  }
}

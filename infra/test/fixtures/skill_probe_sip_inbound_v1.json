{
  "skill_id": "skill_probe_sip_inbound_v1",
  "name": "Probe - chamada telefonica entrante pela perna SIP (VOZ-02)",
  "version": "1.0",
  "description": "Fixture do probe_voz02_sip_inbound: cumprimenta (e e a fala que ATENDE a chamada — o servico SIP so atende quando ha audio na sala), pergunta por voz com duas opcoes e UMA tentativa, e manda um marcador com o que ouviu. Depois encerra: e o encerramento que derruba a chamada pelo lado da plataforma.",
  "classification": {"type": "orchestrator"},
  "flow": {
    "entry": "n0",
    "steps": [
      {"id": "n0", "type": "notify", "message": "Ola. Voce ligou para o teste da plataforma.", "on_success": "m0", "on_failure": "fim_falha"},
      {"id": "m0", "type": "menu", "interaction": "button", "prompt": "Diga atendente ou cancelar.",
       "options": [{"id": "cancelar", "label": "Cancelar"}, {"id": "atendente", "label": "Atendente"}],
       "timeout_s": 120, "output_as": "r0",
       "collect": {"input": ["voice"], "first_input_timeout_s": 30, "max_invalid": 1},
       "on_success": "v0", "on_failure": "fim_falha", "on_timeout": "n_to", "on_invalid": "i0"},
      {"id": "v0", "type": "notify", "message": "sip-m0={{$.pipeline_state.r0}}", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "i0", "type": "notify", "message": "sip-m0-invalido", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "n_to", "type": "notify", "message": "sip-timeout", "on_success": "fim", "on_failure": "fim_falha"},
      {"id": "fim", "type": "complete", "outcome": "resolved", "issue_status": "probe: chamada telefonica atendida"},
      {"id": "fim_falha", "type": "complete", "outcome": "failed", "issue_status": "probe: fluxo falhou"}
    ]
  }
}

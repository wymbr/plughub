probe_monitor_suspended_action.sh

# PUL-01 (2026-09-09): a "lacuna 2" tinha 13 meses de ficha dizendo *"ninguem a
# mediu e nao ha reaper"*. Este probe MEDE, e o veredicto e' LINHA DE BASE, nao
# "consertado": verde = o mundo continua como a ficha descreve (janela aberta,
# dano zero). Vermelho = mudou, inclusive para melhor. Um gate que reprovasse por
# a lacuna existir nasceria permanentemente vermelho.
# Custo: ~45 s (espera o ciclo do CrashDetector). Semeia e LIMPA — Redis por
# varredura e mutacao ancorada no ClickHouse; a primeira versao limpava so o que
# semeava e deixou 22 chaves + 1 sessao + 1 segmento.
probe_claim_lease_invisibility.sh

# PUL-02 (2026-09-09): a Camada F fechou o arco de detach em 2026-07-30 validada A
# MAO, com sondas instrumentadas para aquela sessao — "arco completo sem gate
# versionado e lembranca, nao verificacao". Este gate NAO re-encena a coreografia
# de julho (ambiente montado, acw_timeout_hours=0.03): afere as proposicoes que
# sobrevivem no dado duravel e que regridem em SILENCIO. A F2 e a que mais custa
# perder — `handle_time_ms` e NULL nas sessoes internas, entao a contaminacao nao
# apareceria na media, e sim na CONTAGEM: media enviesada alguem questiona, volume
# dobrado parece dia movimentado.
# Bateria de mutacao: 2 mutacoes, ambas vermelhas (scope trocado; segmento de
# wrap-up com issue_status), e verde de volta apos restaurar.
gate_camada_f.sh

# AUT-39 (2026-09-09): `config.users` era irrestrito. Medido ao vivo ANTES do
# conserto: supervisor com o campo e ZERO pools listou os 9 usuarios do tenant,
# trocou a senha de um usuario de outro time (200), ENTROU na conta, e a original
# deixou de valer. Nao e escalacao (o alvo nao esta acima) — e tomada LATERAL.
# O ramo 3 e o que impede o verde errado: um enforcement que negasse tudo deixaria

gate_orphan_ui_callers.sh
gate_bg_task_visibility.sh
probe_segments_journey_window.sh
# Compila o `catalog.ts` do platform-ui dentro de um container Node da stack: nao ha
# runner de teste no pacote, e um `vitest` que ninguem instalou nao e cobertura.
probe_dashboard_card_title.sh
# Chave repetida em locale: JSON valido, build verde, e a ultima ocorrencia apaga a
# anterior. Um probe de PARIDADE EN x pt-BR nao pega (os dois quebram igual).
probe_i18n_duplicate_keys.sh

# -- ContextStore / arco ALLOWLIST -------------------------------------------
# Nenhum gate deste arco estava no manifesto ate 2026-09-02, embora existissem desde a
# CNS-06. E o modo de falha que este runner foi criado para impedir, acontecendo dentro
# de casa: gate que ninguem roda nao e cobertura.
# O de paridade exige DOCKER (a metade TS roda em container) e sai INCONCLUSIVO sem ele.
probe_ctx_writer_census.sh
probe_context_stamp_parity.sh
# Decisao #6: um motor de mascara por TIPO, nao dois. Exige DOCKER (metade TS em container).
probe_masking_apply_parity.sh
# ALW-03: exige a stack de pe (o ramo G cria uma cobaia, loga e escreve o mapa de volta
# IDENTICO). Sem ela sai SEM AMOSTRA, que nao e verde.
probe_context_map_grant_split.sh
# ALW-12: exige a stack. O ramo F escreve uma linha de TENANT direto no banco (a API a
# recusa desde a CNS-08) e apaga o cache Redis do config-api — nunca toca `__global__`,
# e o trap limpa em EXIT/INT/TERM. Sem stack sai INCONCLUSIVO.
probe_context_map_seed.sh
# V4/F2: paridade do EXTRATOR de escritas de ctx (TS x Python) sobre fixture unica.
# Exige DOCKER (metade TS roda em node:20-alpine com esbuild). Nao precisa da stack.
probe_context_tag_extractor_parity.sh
# Precisa de um principal de escopo ESTREITO — com admin o marcador nasce correto
# e o defeito nao e exercido (o proprio probe declara isso e sai INCONCLUSIVO).
ADMIN_EMAIL=operator@plughub.local ADMIN_PASS=changeme_operator probe_process_chip_scoped_marker.sh

# ══ ASSISTIDOS ═══════════════════════════════════════════════════════════════
# Nao rodam sozinhos. O requisito vai depois do nome, e e o que o runner imprime.

!gate_pause_capacity.sh   exige um agente humano LOGADO no Console (a instancia nasce no login WS, `registerHumanAgent`) — forjar a chave em Redis testaria a forja, nao o produto
!gate_queue_segment_not_born_without_flow.sh   exige T0 colhido ANTES do fluxo: T0=$(date -u +%FT%TZ)
!gate_sentiment_engine_half.sh   exige T0 colhido ANTES de abrir o contato, e um contato que ENFILEIRE
!probe_release_reclaim_race.sh   exige <pool_id> <instance_id> de uma instancia viva

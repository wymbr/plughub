# .env.demo.example
# Copie este arquivo para .env.demo e preencha os valores antes de rodar a demo.
#
# Usage:
#   cp .env.demo.example .env.demo
#   docker compose -f docker-compose.demo.yml --env-file .env.demo up --build

# Necessária apenas se ai-gateway for usado nos cenários (scenarios 01, 02 usam LLM real).
# Pode deixar vazio para cenários 07 e 08 que não chamam o AI Gateway diretamente.
ANTHROPIC_API_KEY=

# Cenários a executar. Padrão: --demo (todos os cenários 01–08)
# Opções: --demo | --only 07 | --only 08 | --conference | --perf
E2E_EXTRA_ARGS=--demo

# ── Bootstrap do primeiro usuário (auth-api) ─────────────────────────────────
# Tudo opcional: os defaults abaixo são os do `config.py`. Descomente para uma
# instalação que não seja a demo.
#
# ⚠️ Estes valores só valem na PRIMEIRA subida — o seed é if-absent. Uma vez que o
# usuário existe, o banco é a fonte de verdade e mudar aqui é no-op.
#PLUGHUB_AUTH_SEED_ADMIN_EMAIL=admin@plughub.local
#PLUGHUB_AUTH_SEED_ADMIN_PASSWORD=changeme_admin
#PLUGHUB_AUTH_SEED_ADMIN_NAME=Admin
# Papéis do admin semeado, separados por vírgula. Eles decidem o PRESET de
# `module_config` — papel fora do catálogo faz o boot RECUSAR, de propósito: sob o
# portão grant-first um admin sem preset nasce sem menu e sem poder se conceder nada.
# Válidos: operator | supervisor | admin | developer | business
#PLUGHUB_AUTH_SEED_ADMIN_ROLES=admin
